# Copy to .env and fill in real values. .env is git-ignored.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_exam?schema=public"
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Auth (used from Step 3 onwards)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# OTP provider (used from Step 3 onwards)
OTP_PROVIDER="redis"
OTP_TTL_SECONDS=300
REDIS_URL="redis://localhost:6379"

# Allowed frontend origin
CORS_ORIGIN="http://localhost:5173"
