# Copy to .env and fill in real values. .env is git-ignored.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_exam?schema=public"
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Auth (used from Step 3 onwards)
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# OTP
OTP_PROVIDER="memory"
OTP_SENDER="console"
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
REDIS_URL="redis://localhost:6379"

# SMTP (used when OTP_SENDER=email)
# For Gmail: enable 2FA, generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# Redirect all OTP emails to this address (set for demos with fictitious seed emails)
SMTP_OVERRIDE_TO=""

# Allowed frontend origin
CORS_ORIGIN="http://localhost:5173"
